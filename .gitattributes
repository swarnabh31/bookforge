# Normalise line endings so the repo is identical on Windows, macOS and Linux.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
*.json  text eol=lf

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

*.pdf   binary
*.epub  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
